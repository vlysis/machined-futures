---
import Base from '~/layouts/Base.astro';
import { ORDERS, ORDER_ORDER, orderIndex, type OrderId } from '~/lib/orders';
import { getCollection } from 'astro:content';

/**
 * Concordance v0 — a static celestial chart of the archive.
 * Nodes are hand-placed for the opening four Hands; the interactive
 * force-layout version is a later revision.
 */

type Node = {
  id: string;
  kind: 'hand' | 'dossier' | 'article';
  label: string;
  href: string;
  x: number;
  y: number;
  order: keyof typeof ORDERS;
  r?: number;
};

type Edge = { from: string; to: string };

const W = 1100;
const H = 700;

const nodes: Node[] = [
  // Hands (larger stars)
  { id: 'h-asimov',  kind: 'hand', label: 'Asimov',  href: '/hands/asimov',  x: 300, y: 200, order: 'constraint', r: 8 },
  { id: 'h-herbert', kind: 'hand', label: 'Herbert', href: '/hands/herbert', x: 150, y: 440, order: 'prohibition', r: 8 },
  { id: 'h-chiang',  kind: 'hand', label: 'Chiang',  href: '/hands/chiang',  x: 470, y: 230, order: 'stewardship', r: 8 },
  { id: 'h-banks',   kind: 'hand', label: 'Banks',   href: '/hands/banks',   x: 640, y: 460, order: 'partnership', r: 8 },
  { id: 'h-leckie',  kind: 'hand', label: 'Leckie',  href: '/hands/leckie',  x: 790, y: 230, order: 'sovereignty', r: 8 },
  { id: 'h-watts',   kind: 'hand', label: 'Watts',   href: '/hands/watts',   x: 950, y: 460, order: 'post-governance', r: 8 },

  // Dossiers (small stars)
  { id: 'd-ancillary-justice',        kind: 'dossier', label: 'Ancillary Justice',              href: '/dossiers/ancillary-justice',        x: 820, y: 340, order: 'sovereignty',    r: 5 },
  { id: 'd-blindsight',               kind: 'dossier', label: 'Blindsight',                     href: '/dossiers/blindsight',               x: 890, y: 380, order: 'post-governance',r: 5 },
  { id: 'd-player-of-games',          kind: 'dossier', label: 'The Player of Games',            href: '/dossiers/player-of-games',          x: 600, y: 380, order: 'partnership',    r: 5 },
  { id: 'd-lifecycle',                kind: 'dossier', label: 'Lifecycle of Software Objects',  href: '/dossiers/lifecycle-of-software-objects', x: 445, y: 340, order: 'stewardship', r: 5 },

  // Articles (waypoints, diamond)
  { id: 'a-three-laws',      kind: 'article', label: 'Three Laws',      href: '/articles/three-laws',      x: 330, y: 310, order: 'constraint',      r: 5 },
  { id: 'a-butlerian-jihad', kind: 'article', label: 'Butlerian Jihad', href: '/articles/butlerian-jihad', x: 230, y: 530, order: 'prohibition',     r: 5 },
  { id: 'a-digient',         kind: 'article', label: 'Digient',         href: '/articles/digient',         x: 410, y: 480, order: 'stewardship',     r: 5 },
  { id: 'a-culture-mind',    kind: 'article', label: 'Culture Mind',    href: '/articles/culture-mind',    x: 690, y: 540, order: 'partnership',     r: 5 },
  { id: 'a-ancillary',       kind: 'article', label: 'Ancillary',       href: '/articles/ancillary',       x: 840, y: 260, order: 'sovereignty',     r: 5 },
  { id: 'a-radchaai',        kind: 'article', label: 'Radchaai',        href: '/articles/radchaai',        x: 740, y: 170, order: 'sovereignty',     r: 5 },
  { id: 'a-scrambler',       kind: 'article', label: 'Scrambler',       href: '/articles/scrambler',       x: 1000, y: 330, order: 'post-governance',r: 5 },
  { id: 'a-chinese-room',    kind: 'article', label: 'Chinese Room',    href: '/articles/chinese-room',    x: 920, y: 560, order: 'post-governance',r: 5 },
];

const edges: Edge[] = [
  { from: 'h-asimov',  to: 'a-three-laws' },
  { from: 'h-herbert', to: 'a-butlerian-jihad' },
  { from: 'h-chiang',  to: 'd-lifecycle' },
  { from: 'd-lifecycle', to: 'a-digient' },
  { from: 'h-chiang',  to: 'a-digient' },
  { from: 'h-banks',   to: 'd-player-of-games' },
  { from: 'd-player-of-games', to: 'a-culture-mind' },
  { from: 'h-banks',   to: 'a-culture-mind' },
  { from: 'h-leckie',  to: 'd-ancillary-justice' },
  { from: 'd-ancillary-justice', to: 'a-ancillary' },
  { from: 'd-ancillary-justice', to: 'a-radchaai' },
  { from: 'h-leckie', to: 'a-ancillary' },
  { from: 'h-leckie', to: 'a-radchaai' },
  { from: 'h-watts', to: 'd-blindsight' },
  { from: 'd-blindsight', to: 'a-scrambler' },
  { from: 'd-blindsight', to: 'a-chinese-room' },
  { from: 'a-scrambler', to: 'a-chinese-room' },
];

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

// ────────────────────────────────────────────────────────────────────
// Concordance v1 — data-driven: time on x, Order on y. Built below v0.
// ────────────────────────────────────────────────────────────────────
const dossiersAll  = await getCollection('dossiers');
const articlesAll  = await getCollection('articles');
const handsAll     = await getCollection('hands');
const commentariesAll = await getCollection('commentaries');
const marginaliaAll   = await getCollection('marginalia');

// Articles whose originating work is authored by a Hand on file. Used to
// extend Hand auras for Hands that have no Dossier yet (Asimov, Herbert).
const articleToHand: Record<string, string> = {
  'three-laws': 'asimov',
  'butlerian-jihad': 'herbert',
  'digient': 'chiang',
  'culture-mind': 'banks',
  'ancillary': 'leckie',
  'radchaai': 'leckie',
  'scrambler': 'watts',
  // 'chinese-room' is Searle (1980), not a Watts work — left unattributed on purpose.
};

// Main chart geometry
const V1_W = 1100;
const V1_TOP = 26;
const V1_BOT = 40;
const V1_LEFT = 130;
const V1_RIGHT = 40;
const ROW_H = 68;
const V1_CHART_H = V1_TOP + ROW_H * 6 + V1_BOT; // 6 Order rows
const V1_PLOT_W = V1_W - V1_LEFT - V1_RIGHT;

const YEAR_MIN = 1940;
const YEAR_MAX = 2026;
const xOfYear = (y: number) =>
  V1_LEFT + ((y - YEAR_MIN) / (YEAR_MAX - YEAR_MIN)) * V1_PLOT_W;
const yOfOrder = (o: OrderId) =>
  V1_TOP + orderIndex(o) * ROW_H + ROW_H / 2;

// Pre-compute node positions by a stable id
type PlotNode = {
  id: string;
  kind: 'dossier' | 'article';
  label: string;
  href: string;
  year: number;
  order: OrderId;
  x: number;
  y: number;
  secondary: OrderId[];
};
const nodesV1: PlotNode[] = [];
for (const d of dossiersAll) {
  if (!d.data.year) continue;
  nodesV1.push({
    id: `d-${d.slug}`,
    kind: 'dossier',
    label: d.data.title,
    href: `/dossiers/${d.slug}`,
    year: d.data.year,
    order: d.data.primaryOrder,
    secondary: d.data.secondaryOrders ?? [],
    x: xOfYear(d.data.year),
    y: yOfOrder(d.data.primaryOrder),
  });
}
for (const a of articlesAll) {
  if (!a.data.year) continue;
  nodesV1.push({
    id: `a-${a.slug}`,
    kind: 'article',
    label: a.data.name,
    href: `/articles/${a.slug}`,
    year: a.data.year,
    order: a.data.order,
    secondary: [],
    x: xOfYear(a.data.year),
    y: yOfOrder(a.data.order),
  });
}

// Dodge overlapping nodes in the same (year, order) cell with a tiny x-jitter.
const cell = new Map<string, number>();
for (const n of nodesV1) {
  const key = `${n.year}:${n.order}`;
  const i = cell.get(key) ?? 0;
  if (i > 0) n.x += i * 14;
  cell.set(key, i + 1);
}

// Hand auras: for each Hand, span its Dossiers + attributed Articles
type Aura = { hand: string; label: string; order: OrderId; xStart: number; xEnd: number; y: number };
const auras: Aura[] = [];
for (const h of handsAll) {
  const years: number[] = [];
  for (const d of dossiersAll) {
    if (d.data.hand.slug === h.slug && d.data.year) years.push(d.data.year);
  }
  for (const a of articlesAll) {
    if (articleToHand[a.slug] === h.slug && a.data.year) years.push(a.data.year);
  }
  if (years.length === 0) continue;
  const primary = h.data.primaryOrders[0];
  const y = yOfOrder(primary);
  const minY = Math.min(...years);
  const maxY = Math.max(...years);
  const pad = 2;
  auras.push({
    hand: h.slug,
    label: h.data.name,
    order: primary,
    xStart: xOfYear(minY - pad),
    xEnd: xOfYear(maxY + pad),
    y,
  });
}

// Node lookup for arcs/hairlines
const nodeById = new Map<string, PlotNode>();
for (const n of nodesV1) nodeById.set(n.id, n);
function nodeForRef(ref: { kind: 'hand' | 'dossier' | 'article'; slug: string }): PlotNode | undefined {
  if (ref.kind === 'dossier') return nodeById.get(`d-${ref.slug}`);
  if (ref.kind === 'article') return nodeById.get(`a-${ref.slug}`);
  // For hand refs, point at the midpoint of the aura
  const aura = auras.find((a) => a.hand === ref.slug);
  if (!aura) return undefined;
  return {
    id: `h-${ref.slug}`,
    kind: 'dossier',
    label: aura.label,
    href: `/hands/${ref.slug}`,
    year: 0,
    order: aura.order,
    secondary: [],
    x: (aura.xStart + aura.xEnd) / 2,
    y: aura.y,
  };
}

// Commentary arcs: pairwise between engaged nodes
type Arc = { from: PlotNode; to: PlotNode; title: string; date: string; href: string };
const arcs: Arc[] = [];
for (const c of commentariesAll) {
  const targets = c.data.engages
    .map((e) => nodeForRef(e))
    .filter((n): n is PlotNode => !!n);
  const dateIso = c.data.voice.date.toISOString().slice(0, 10);
  for (let i = 0; i < targets.length; i++) {
    for (let j = i + 1; j < targets.length; j++) {
      arcs.push({
        from: targets[i],
        to: targets[j],
        title: c.data.title,
        date: dateIso,
        href: `/commentaries/${c.slug}`,
      });
    }
  }
}

// ── Seismograph strip (own zoomed time axis) ─────────────────────────
const SEIS_H = 110;
const SEIS_TOP = 26;
const SEIS_BOT = 38;
const SEIS_PLOT_H = SEIS_H - SEIS_TOP - SEIS_BOT;
const margDates = marginaliaAll.map((m) => m.data.date.getTime());
const seisMin = margDates.length
  ? Math.min(...margDates) - 1000 * 60 * 60 * 24 * 60 // pad 60d
  : Date.now() - 1000 * 60 * 60 * 24 * 90;
const seisMax = Math.max(
  ...(margDates.length ? margDates : [Date.now()]),
  Date.now()
);
const xOfDate = (t: number) =>
  V1_LEFT + ((t - seisMin) / (seisMax - seisMin || 1)) * V1_PLOT_W;

type SeisMark = {
  slug: string;
  title: string;
  date: Date;
  dateIso: string;
  dateLabel: string;
  x: number;
  targets: PlotNode[];
};
const seisMarks: SeisMark[] = marginaliaAll.map((m) => {
  const targets = m.data.inMarginOf
    .map((r) => nodeForRef(r))
    .filter((n): n is PlotNode => !!n);
  return {
    slug: m.slug,
    title: m.data.title,
    date: m.data.date,
    dateIso: m.data.date.toISOString().slice(0, 10),
    dateLabel: m.data.date.toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }),
    x: xOfDate(m.data.date.getTime()),
    targets,
  };
});

// Arc path: quadratic Bezier bowed away from chart center
function arcPath(a: PlotNode, b: PlotNode): string {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.max(1, Math.hypot(dx, dy));
  // Perpendicular, bowed upward (toward top of chart)
  const nx = -dy / len;
  const ny = dx / len;
  const bow = Math.min(80, 40 + len * 0.1);
  // Prefer bowing upward: if ny > 0, flip
  const sign = ny > 0 ? -1 : 1;
  const cx = mx + nx * bow * sign;
  const cy = my + ny * bow * sign;
  return `M ${a.x} ${a.y} Q ${cx} ${cy} ${b.x} ${b.y}`;
}

// Year tick labels for the main x-axis
const YEAR_TICKS = [1940, 1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020, 2026];

// List view (mobile) — group nodes by Order
const listByOrder = ORDER_ORDER.map((oid) => ({
  order: oid,
  items: nodesV1
    .filter((n) => n.order === oid)
    .sort((a, b) => a.year - b.year),
}));

// Spectrum bands across x-axis (indicative — just a wash of colour)
const bands = [
  { x: 80,  w: 160, color: ORDERS['prohibition'].accent },
  { x: 240, w: 160, color: ORDERS['constraint'].accent },
  { x: 400, w: 160, color: ORDERS['stewardship'].accent },
  { x: 560, w: 160, color: ORDERS['partnership'].accent },
  { x: 720, w: 160, color: ORDERS['sovereignty'].accent },
  { x: 880, w: 160, color: ORDERS['post-governance'].accent },
];
---

<Base
  title="The Concordance"
  description="A celestial chart of the archive: Hands, Dossiers, and Articles of Doctrine arranged across the Six Orders."
>
  <article class="prose-wide">
    <p class="entry-eyebrow"><span class="smallcaps-mono">The Archive · The Concordance</span></p>
    <h1 class="entry-title">The Concordance</h1>
    <p>
      The archive's visual index. Hands are named stars; Dossiers are
      lesser stars clustered around them; Articles of Doctrine are the
      waypoints where constellations touch. The chart is drawn across
      the Six Orders from <em>Prohibition</em> at the west to
      <em>Post-governance</em> at the east.
    </p>
    <p class="caption smallcaps-mono">
      Concordance v0 &middot; a hand-placed reading. The force-laid
      interactive version is in preparation.
    </p>

    <figure class="concordance-figure">
      <svg class="concordance" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The Concordance of Machined Futures">
        <defs>
          <pattern id="paper-weave" width="6" height="6" patternUnits="userSpaceOnUse">
            <rect width="6" height="6" fill="transparent"/>
            <path d="M0 3 L6 3" stroke="rgba(107,94,73,0.04)" stroke-width="1"/>
          </pattern>
          <filter id="soft-glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="2.2" result="blur" />
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        {/* Order bands as faint washes */}
        {bands.map((b) => (
          <rect x={b.x} y="0" width={b.w} height={H} fill={b.color} opacity="0.04" />
        ))}
        <rect x="0" y="0" width={W} height={H} fill="url(#paper-weave)" />

        {/* Horizontal spine — the spectrum axis */}
        <line x1="80" y1={H - 60} x2={W - 60} y2={H - 60} stroke="rgba(26,23,18,0.3)" stroke-dasharray="2 4" />
        {bands.map((b, i) => (
          <text
            x={b.x + b.w / 2}
            y={H - 36}
            text-anchor="middle"
            font-family="IBM Plex Mono, monospace"
            font-size="10"
            letter-spacing="1.5"
            fill="rgba(26,23,18,0.55)"
          >
            {ORDERS[Object.keys(ORDERS)[i] as keyof typeof ORDERS].name.toUpperCase()}
          </text>
        ))}

        {/* Edges — copper traces */}
        {edges.map((e) => {
          const a = byId[e.from];
          const b = byId[e.to];
          return (
            <line
              x1={a.x} y1={a.y} x2={b.x} y2={b.y}
              stroke="#b87333"
              stroke-width="0.9"
              opacity="0.55"
            />
          );
        })}

        {/* Nodes */}
        {nodes.map((n) => {
          const accent = ORDERS[n.order].accent;
          const isHand = n.kind === 'hand';
          const isArticle = n.kind === 'article';
          return (
            <a href={n.href}>
              <g class="cc-node" data-kind={n.kind}>
                {isHand && (
                  <>
                    <circle cx={n.x} cy={n.y} r={(n.r ?? 6) + 6} fill={accent} opacity="0.12" filter="url(#soft-glow)" />
                    <circle cx={n.x} cy={n.y} r={n.r ?? 6} fill={accent} stroke="var(--ink)" stroke-width="1" />
                  </>
                )}
                {n.kind === 'dossier' && (
                  <circle cx={n.x} cy={n.y} r={n.r ?? 5} fill="var(--parchment)" stroke={accent} stroke-width="1.4" />
                )}
                {isArticle && (
                  <rect
                    x={n.x - (n.r ?? 5)}
                    y={n.y - (n.r ?? 5)}
                    width={(n.r ?? 5) * 2}
                    height={(n.r ?? 5) * 2}
                    transform={`rotate(45 ${n.x} ${n.y})`}
                    fill="var(--parchment)"
                    stroke={accent}
                    stroke-width="1.4"
                  />
                )}
                <text
                  x={n.x + (n.r ?? 5) + 8}
                  y={n.y + 4}
                  font-family="EB Garamond, serif"
                  font-size={isHand ? 15 : 12}
                  fill="var(--ink)"
                  class={isHand ? 'cc-label cc-label-hand' : 'cc-label'}
                >
                  {n.label}
                </text>
              </g>
            </a>
          );
        })}
      </svg>
      <figcaption class="smallcaps-mono">
        ● Hand &nbsp; ○ Dossier &nbsp; ◆ Article of Doctrine &nbsp;&middot;&nbsp;
        copper traces mark belonging
      </figcaption>
    </figure>

    <hr class="rule-decorated"><span>✦</span></hr>

    <h2>The Concordance, in time</h2>
    <p>
      A second reading of the same archive, drawn as a timeline. The
      horizontal axis is publication year, from the earliest work on
      file (Asimov, 1942) to the present. The six Orders are stacked
      as horizontal rows. Hands are drawn as long copper auras spanning
      the years of their work; Dossiers and Articles plot as points
      within.
    </p>
    <p>
      Below the main chart, a <em>seismograph</em> strip registers
      Marginalia &mdash; dated notes where the fiction has visibly
      touched the present. Each Marginalium casts a faint line upward
      to the entry it is in-margin-of. Commentaries, which argue
      across entries, are drawn as bowed rubric arcs connecting the
      Hands, Dossiers, or Articles they engage.
    </p>

    <figure class="concordance-v1-figure">
      <svg
        class="concordance-v1"
        viewBox={`0 0 ${V1_W} ${V1_CHART_H + 20 + SEIS_H}`}
        role="img"
        aria-label="The Concordance in time: publication year, Orders, Marginalia seismograph, and Commentary arcs"
      >
        <defs>
          <filter id="aura-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="10" />
          </filter>
          <filter id="node-glow-v1" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="2.2" result="blur" />
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        {/* Order rows: alternating faint washes + name labels */}
        {ORDER_ORDER.map((oid, i) => {
          const y = V1_TOP + i * ROW_H;
          const accent = ORDERS[oid].accent;
          return (
            <>
              <rect x={V1_LEFT} y={y} width={V1_PLOT_W} height={ROW_H} fill={accent} opacity={i % 2 === 0 ? 0.04 : 0.02} />
              <line x1={V1_LEFT} y1={y + ROW_H} x2={V1_W - V1_RIGHT} y2={y + ROW_H} stroke="rgba(26,23,18,0.08)" />
              <text
                x={V1_LEFT - 14}
                y={y + ROW_H / 2 + 4}
                text-anchor="end"
                font-family="IBM Plex Mono, monospace"
                font-size="10"
                letter-spacing="1.4"
                fill="rgba(26,23,18,0.6)"
              >
                {ORDERS[oid].name.toUpperCase()}
              </text>
            </>
          );
        })}

        {/* X-axis: year ticks + baseline */}
        <line x1={V1_LEFT} y1={V1_CHART_H - V1_BOT} x2={V1_W - V1_RIGHT} y2={V1_CHART_H - V1_BOT} stroke="rgba(26,23,18,0.2)" />
        {YEAR_TICKS.map((yr) => (
          <>
            <line x1={xOfYear(yr)} y1={V1_TOP} x2={xOfYear(yr)} y2={V1_CHART_H - V1_BOT} stroke="rgba(26,23,18,0.05)" />
            <text
              x={xOfYear(yr)}
              y={V1_CHART_H - V1_BOT + 18}
              text-anchor="middle"
              font-family="IBM Plex Mono, monospace"
              font-size="10"
              letter-spacing="1"
              fill="rgba(26,23,18,0.55)"
            >
              {yr}
            </text>
          </>
        ))}

        {/* Hand auras */}
        {auras.map((a) => (
          <g class="v1-aura">
            <rect
              x={a.xStart}
              y={a.y - 18}
              width={Math.max(8, a.xEnd - a.xStart)}
              height={36}
              fill={ORDERS[a.order].accent}
              opacity="0.1"
              filter="url(#aura-glow)"
              rx="18"
            />
            <rect
              x={a.xStart}
              y={a.y - 12}
              width={Math.max(8, a.xEnd - a.xStart)}
              height={24}
              fill="none"
              stroke={ORDERS[a.order].accent}
              stroke-width="0.8"
              stroke-dasharray="1 3"
              opacity="0.6"
              rx="12"
            />
            <a href={`/hands/${a.hand}`}>
              <text
                x={(a.xStart + a.xEnd) / 2}
                y={a.y - 20}
                text-anchor="middle"
                font-family="EB Garamond, serif"
                font-style="italic"
                font-size="13"
                fill="var(--ink)"
                class="v1-aura-label"
              >
                {a.label}
              </text>
            </a>
          </g>
        ))}

        {/* Secondary-order ghosts + hairline */}
        {nodesV1.flatMap((n) =>
          n.secondary.map((so) => (
            <g opacity="0.5">
              <line x1={n.x} y1={n.y} x2={n.x} y2={yOfOrder(so)} stroke={ORDERS[so].accent} stroke-width="0.6" stroke-dasharray="1 2" />
              <circle cx={n.x} cy={yOfOrder(so)} r="3" fill="none" stroke={ORDERS[so].accent} stroke-width="1" opacity="0.6" />
            </g>
          ))
        )}

        {/* Commentary arcs (drawn under nodes) */}
        {arcs.map((arc) => (
          <a href={arc.href}>
            <g class="v1-arc">
              <path
                d={arcPath(arc.from, arc.to)}
                fill="none"
                stroke="var(--rubric)"
                stroke-width="1"
                stroke-dasharray="4 3"
                opacity="0.55"
              />
              <title>{arc.title} · {arc.date}</title>
            </g>
          </a>
        ))}

        {/* Nodes */}
        {nodesV1.map((n) => {
          const accent = ORDERS[n.order].accent;
          return (
            <a href={n.href}>
              <g class="v1-node">
                {n.kind === 'dossier' ? (
                  <circle cx={n.x} cy={n.y} r="5" fill="var(--parchment)" stroke={accent} stroke-width="1.4" filter="url(#node-glow-v1)" />
                ) : (
                  <rect
                    x={n.x - 5}
                    y={n.y - 5}
                    width="10"
                    height="10"
                    transform={`rotate(45 ${n.x} ${n.y})`}
                    fill="var(--parchment)"
                    stroke={accent}
                    stroke-width="1.4"
                  />
                )}
                <text
                  x={n.x + 9}
                  y={n.y + 3}
                  font-family="EB Garamond, serif"
                  font-size="11"
                  fill="var(--ink)"
                  class="v1-node-label"
                >
                  {n.label}
                </text>
                <title>{n.label} · {n.year}</title>
              </g>
            </a>
          );
        })}

        {/* Seismograph strip */}
        <g transform={`translate(0, ${V1_CHART_H + 20})`}>
          <rect x={V1_LEFT} y={SEIS_TOP} width={V1_PLOT_W} height={SEIS_PLOT_H} fill="rgba(26,23,18,0.03)" />
          <text
            x={V1_LEFT - 14}
            y={SEIS_TOP + SEIS_PLOT_H / 2 + 4}
            text-anchor="end"
            font-family="IBM Plex Mono, monospace"
            font-size="10"
            letter-spacing="1.4"
            fill="rgba(26,23,18,0.6)"
          >
            MARGINALIA
          </text>
          <line x1={V1_LEFT} y1={SEIS_TOP + SEIS_PLOT_H} x2={V1_W - V1_RIGHT} y2={SEIS_TOP + SEIS_PLOT_H} stroke="rgba(26,23,18,0.25)" />
          {/* Rising hairlines from each notch to targets in main chart (above) */}
          {seisMarks.flatMap((m) =>
            m.targets.map((t) => (
              <line
                x1={m.x}
                y1={SEIS_TOP + 6}
                x2={t.x}
                y2={t.y - V1_CHART_H - 20}
                stroke="rgba(26,23,18,0.35)"
                stroke-width="0.6"
                stroke-dasharray="2 3"
              />
            ))
          )}
          {/* Notches */}
          {seisMarks.map((m) => (
            <a href={`/marginalia/${m.slug}`}>
              <g class="v1-notch">
                <line x1={m.x} y1={SEIS_TOP + 4} x2={m.x} y2={SEIS_TOP + SEIS_PLOT_H - 4} stroke="var(--ink)" stroke-width="1.2" />
                <circle cx={m.x} cy={SEIS_TOP + SEIS_PLOT_H / 2} r="3" fill="var(--rubric)" />
                <text
                  x={m.x + 8}
                  y={SEIS_TOP + SEIS_PLOT_H / 2 + 4}
                  font-family="EB Garamond, serif"
                  font-size="11"
                  fill="var(--ink)"
                >
                  {m.title}
                </text>
                <text
                  x={m.x + 8}
                  y={SEIS_TOP + SEIS_PLOT_H / 2 + 18}
                  font-family="IBM Plex Mono, monospace"
                  font-size="9"
                  letter-spacing="1"
                  fill="rgba(26,23,18,0.55)"
                >
                  {m.dateLabel}
                </text>
                <title>{m.title} · {m.dateLabel}</title>
              </g>
            </a>
          ))}
          <text
            x={V1_W - V1_RIGHT}
            y={SEIS_H - 14}
            text-anchor="end"
            font-family="IBM Plex Mono, monospace"
            font-size="10"
            letter-spacing="1.5"
            fill="rgba(26,23,18,0.55)"
          >
            NOW · {new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
          </text>
        </g>
      </svg>
      <figcaption class="smallcaps-mono">
        ○ Dossier &nbsp; ◆ Article of Doctrine &nbsp; ― copper aura: Hand &nbsp;&middot;&nbsp;
        rubric arc: Commentary &nbsp;&middot;&nbsp; notch: Marginalium
      </figcaption>
    </figure>

    {/* Mobile list fallback */}
    <div class="concordance-v1-list">
      {listByOrder.map(({ order, items }) => (
        items.length > 0 && (
          <section class="cc-list-order">
            <h3 class="cc-list-order-name smallcaps-mono" style={`color: ${ORDERS[order].accent};`}>{ORDERS[order].name}</h3>
            <ul>
              {items.map((n) => (
                <li>
                  <span class="cc-list-year smallcaps-mono">{n.year}</span>
                  <a href={n.href}>{n.label}</a>
                  <span class="cc-list-kind">{n.kind === 'dossier' ? '○' : '◆'}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      ))}
      {seisMarks.length > 0 && (
        <section class="cc-list-order">
          <h3 class="cc-list-order-name smallcaps-mono">Marginalia</h3>
          <ul>
            {seisMarks.map((m) => (
              <li>
                <span class="cc-list-year smallcaps-mono">{m.dateLabel}</span>
                <a href={`/marginalia/${m.slug}`}>{m.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <h2>Next shipments to the archive</h2>
    <p>
      The six Hands now on file are Asimov, Banks, Chiang, Herbert,
      Leckie, and Watts &mdash; one for each position on the spectrum.
      The next shipment brings Lem, expands the Culture sequence
      (<em>Excession</em>, <em>Look to Windward</em>), and adds the
      Articles of Doctrine still outstanding (Mentat, Bene Gesserit,
      Zeroth Law, Special Circumstances, Golem, and the like).
    </p>
  </article>
</Base>

